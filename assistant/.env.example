# Which local Ollama model to use. Must already be pulled: `ollama pull mistral`.
# Bigger/newer models (llama3.1, qwen2.5) generally follow the "leave it null, don't guess"
# instruction more reliably — see assistant/README.md.
OLLAMA_MODEL=mistral:latest

# The Cash REST API this assistant talks to — never the database directly.
CASH_API_URL=http://127.0.0.1:8000
CASH_USERNAME=change-me
CASH_PASSWORD=change-me
